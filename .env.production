# Security Alerting (Req 26.6) — outbound notification on critical audit
# events. Leave commented to disable; uncomment + set to route to a SIEM/SOC.
# SECURITY_ALERT_WEBHOOK_URL=
# SECURITY_ALERT_WEBHOOK_TOKEN=
# SECURITY_ALERT_EMAIL_TO=
# SECURITY_ALERT_SEVERITY_THRESHOLD=CRITICAL

# HRIMS Integration — trusted-source policy (Req 11.2)
# ---------------------------------------------------------------------------
# Endpoint + credentials are sourced from server config only (never a request
# body). HRIMS_ALLOWED_HOSTS restricts the resolved host to this comma-separated
# allow-list (SSRF guard) — set it to the production HRIMS host. Production
# requires https (HRIMS_API_SCHEME=https); set HRIMS_ALLOW_INSECURE_HTTP=true
# ONLY for a private-network HRIMS without TLS (explicit, audited opt-in).
# HRIMS_HOST=
# HRIMS_PORT=8135
# HRIMS_API_KEY=
# HRIMS_TOKEN=
# HRIMS_ALLOWED_HOSTS=
# HRIMS_API_SCHEME=https
# HRIMS_ALLOW_INSECURE_HTTP=