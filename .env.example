# =============================================================================
# CSMS Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in the actual values.
# NEVER commit .env files to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/nody

# ---------------------------------------------------------------------------
# MinIO Object Storage
# ---------------------------------------------------------------------------
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=documents

# ---------------------------------------------------------------------------
# Redis (Rate Limiting & Caching)
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# SMTP Email
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.com
SMTP_PASSWORD=change-me

# ---------------------------------------------------------------------------
# CSRF Protection
# ---------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
CSRF_SECRET=generate-a-128-character-hex-string

# ---------------------------------------------------------------------------
# MFA Configuration
# ---------------------------------------------------------------------------
MFA_TOKEN_EXPIRY_MINUTES=10
MFA_OTP_RATE_LIMIT=3
MFA_OTP_RATE_WINDOW_SECONDS=60
MFA_MAX_VERIFY_ATTEMPTS=5

# Password Reset (self-service, Req 1.10)
# ---------------------------------------------------------------------------
# Lifetime of an emailed password-reset link, in minutes (≤15 per spec).
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=15
# Max failed new-password attempts before a reset token is invalidated.
PASSWORD_RESET_MAX_VERIFY_ATTEMPTS=5

# ---------------------------------------------------------------------------
# ClamAV (Malware Scanning)
# ---------------------------------------------------------------------------
# CLAMAV_ENABLED=false disables scanning (dev/CI escape hatch). In production
# (NODE_ENV=production) a bare CLAMAV_ENABLED=false is IGNORED so a stray env
# var cannot silently turn off malware scanning; set CLAMAV_DISABLE_ALLOWED=true
# to opt in to the disable (deliberate, ops-only two-key action). Req 10.7.
CLAMAV_ENABLED=false
CLAMAV_DISABLE_ALLOWED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=30000

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=production
NEXT_PUBLIC_APP_URL=http://localhost:9002
NEXT_PUBLIC_API_URL=http://localhost:9002/api
NEXT_PUBLIC_BACKEND_URL=http://localhost:9002

# ---------------------------------------------------------------------------
# AI / Genkit (Optional)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=change-me
OLLAMA_API_KEY=change-me

# ---------------------------------------------------------------------------
# HRIMS Integration (Optional)
# ---------------------------------------------------------------------------
HRIMS_API_URL=
HRIMS_API_TOKEN=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Security Alerting (Req 26.6) — outbound notification on critical audit
# events. All channels are opt-in: leave unset for a no-op (dev/CI default).
#  - SECURITY_ALERT_WEBHOOK_URL: SIEM/webhook endpoint (HTTP POST, JSON body).
#    A Bearer token is sent if SECURITY_ALERT_WEBHOOK_TOKEN is set.
#  - SECURITY_ALERT_EMAIL_TO: comma-separated recipients for email alerts.
#  - SECURITY_ALERT_SEVERITY_THRESHOLD: minimum severity to alert on, one of
#    INFO/WARNING/ERROR/CRITICAL. Default CRITICAL (only the most serious
#    events page a human).
# ---------------------------------------------------------------------------
# SECURITY_ALERT_WEBHOOK_URL=
# SECURITY_ALERT_WEBHOOK_TOKEN=
# SECURITY_ALERT_EMAIL_TO=
# SECURITY_ALERT_SEVERITY_THRESHOLD=CRITICAL
# SECURITY_ALERT_WEBHOOK_TIMEOUT_MS=5000
# SECURITY_ALERT_DEDUP_SECONDS=30
# SECURITY_ALERT_ENVIRONMENT=
