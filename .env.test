# Application URL
E2E_BASE_URL=http://localhost:9002
NODE_ENV=test

# Test Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:Mamlaka2020@localhost:5432/csms_test?schema=public"

# MinIO (Test Storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=csmsadmin
MINIO_SECRET_KEY=Mamlaka2020MinIO
MINIO_BUCKET_NAME=documents-test
NEXT_PUBLIC_MINIO_ENDPOINT=http://localhost:9000

# Redis (Test Queue)
REDIS_HOST=localhost
REDIS_PORT=6379

# CSRF Protection
CSRF_SECRET=test-csrf-secret-key-change-in-production

# Auth
NEXTAUTH_SECRET=test-secret-key-for-testing-only
NEXTAUTH_URL=http://localhost:9002

# Google Genkit AI (Optional for E2E tests)
GOOGLE_GENAI_API_KEY=AIzaSyAHWMHONc3OGRxIRsBw35Ccs56Z_-3VgrY

# HRIMS Integration (Mock for tests)
HRIMS_API_URL=http://localhost:9002/api/mock-hrims
HRIMS_API_KEY=test-hrims-key

# Logging Configuration
LOG_LEVEL=warn

# Session signing + PII encryption keys (test environment)
SESSION_SECRET=e2e-test-session-signing-key-placeholder-not-for-production-use-aaaa
PII_ENCRYPTION_KEY=e2e-test-pii-encryption-key-placeholder-not-for-production-use-aaaa

# RC5: relax the auth rate limit for the E2E suite. The suite makes many logins
# per minute from one IP; the default 5/60s trips before account-lockout runs
# (lock-account test) and causes 429s in auth-heavy tests. Production does NOT
# set this (default 5 applies).
RATE_LIMIT_AUTH_LIMIT=1000
